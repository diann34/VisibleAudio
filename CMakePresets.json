{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/extern/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug (vcpkg)",
      "inherits": "base"
    },
    {
      "name": "release",
      "displayName": "Release (vcpkg)",
      "inherits": "base"
    }
  ],
  "buildPresets": [
    { "name": "dev",     "configurePreset": "dev",     "configuration": "Debug" },
    { "name": "release", "configurePreset": "release", "configuration": "Release" }
  ]
}